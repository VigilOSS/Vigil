# Vigil runtime environment
#
# Copy this file to `.env` at the install or repo root.
# `vigil runtime start` passes this file to `docker run --env-file` so the same
# values are available inside the Kali runtime container; tools like
# `subfinder` consume them there when invoked through `vigil assess kali`.

# Optional local orchestrator URL override used by engagement-sync helper
# scripts. If unset, engagements default to http://127.0.0.1:18000.
ORCHESTRATOR_BASE_URL=

# ============================================
# Kali runtime startup
# These affect how the shared runtime container is started.
# ============================================

REDTEAM_IMAGE=vigil:latest
# Optional override for the host-side runtime data dir (Kali runtime /data mount —
# OOB relay routing, frpc and interactsh state, logs). Read from this file (or the
# shell env) when computing the mount; relative paths resolve against the install
# root. Default: the workspace's runtime_state (state/runtime on a fresh
# workspace, .runtime-data on an adopted one). Distinct from the orchestrator DB
# dir's VIGIL_DATA_DIR. Give each install its own directory and set it here rather
# than in a shell profile: the OOB relay record follows it.
# VIGIL_RUNTIME_DATA_DIR=

# ============================================
# Runtime resource sizing (apply at `vigil runtime start`)
# Conservative defaults; raise them for concurrent or resource-heavy work.
# Process environment overrides this selected workspace file.
# See docs/operations.md for runtime resource sizing.
# ============================================

# Container memory ceiling in GB. Default 2.
VIGIL_RUNTIME_MEMORY_GB=2
# CPU quota for the runtime. Default 1.
VIGIL_RUNTIME_CPUS=1
# Process count cap inside the container. Default 512.
VIGIL_RUNTIME_PIDS_LIMIT=512
# Shared-memory size for nuclei/Chromium-driven workflows. Default 1g.
VIGIL_RUNTIME_SHM_SIZE=1g
# Overrides the runtime container name; shared by vigil_cli and the assess lib. Default vigil.
# VIGIL_RUNTIME_CONTAINER=vigil

# --------------------------------------------
# Runtime egress separation (OPT-IN, OFF by default)
# Give the Kali runtime its OWN egress IP so the agent fleet's target-facing
# traffic does not share (and rate-block) the user-browser's NAT/CDN egress IP.
# Both unset = current behaviour exactly (shares the host/browser egress IP).
# Applied at `vigil runtime start`. See
# agent/references/runtime-guides/runtime-egress-separation.md.
# --------------------------------------------
# Upstream proxy URL → wired in as HTTP(S)_PROXY + ALL_PROXY (both cases).
# Schemes: http/https/socks5/socks5h/socks4/socks4a. Malformed → fails at start.
# Backend traffic (host.docker.internal) is ALWAYS excluded via NO_PROXY.
# CAVEAT: raw-socket tools (nmap/naabu/masscan/ping) IGNORE this and still egress
# the host IP — use VIGIL_RUNTIME_EGRESS_NETWORK (VPN sidecar) to capture those.
# VIGIL_RUNTIME_EGRESS_PROXY=socks5h://proxy.example:1080
# Named, pre-existing Docker network to attach with --network (e.g. a VPN-sidecar
# net for a true separate IP that also captures raw-socket egress).
# VIGIL_RUNTIME_EGRESS_NETWORK=
# Optional extra comma-separated NO_PROXY entries (appended to the mandatory
# host.docker.internal,localhost,127.0.0.1,::1 backend exclusions).
# VIGIL_RUNTIME_EGRESS_NO_PROXY=

# ============================================
# Kali CLI execution defaults
# Consumed by the new `vigil assess kali ...` audit pipeline.
# ============================================

# Default wall-clock timeout for synchronous Kali CLI invocations (seconds).
KALI_CLI_DEFAULT_TIMEOUT=1800
# Window inside which an identical (command, argv) hash is treated as a duplicate.
# Default 30s. Two parallel specialists racing on the same wildcard list inside
# this window get a dedup-warning log line, but the new command still runs and a
# fresh audit row is inserted (with `superseded_by_id` linking back to the
# predecessor). `--force` suppresses the warning text for intentional retries.
KALI_AUDIT_DEDUP_WINDOW_SECONDS=30

# ============================================
# Optional callback tunneling
# frp is the preferred tunnel tool. Configure your frp server address here.
# ============================================

FRP_SERVER_ADDR=

# ============================================
# Passive recon / ProjectDiscovery tooling
# These variables are read by the tools themselves inside the Kali runtime.
# Fill in only the providers you actually use.
# NOTE: the SUBFINDER_* keys are NOT read directly from env by subfinder; at
# `vigil runtime start` they are translated into the generated provider-config
# (~/.config/subfinder/provider-config.yaml) that subfinder reads — so changing a
# SUBFINDER_* value only takes effect after you re-run `vigil runtime start`.
# ============================================

# https://www.virustotal.com/gui/my-apikey
SUBFINDER_VIRUSTOTAL_API_KEY=

# https://securitytrails.com/app/account/credentials
SUBFINDER_SECURITYTRAILS_API_KEY=

# https://account.shodan.io/
SUBFINDER_SHODAN_API_KEY=

# https://chaos.projectdiscovery.io/
SUBFINDER_CHAOS_API_KEY=

# https://community.riskiq.com/login
SUBFINDER_PASSIVETOTAL_USERNAME=
SUBFINDER_PASSIVETOTAL_API_KEY=

# https://censys.io/account/api
SUBFINDER_CENSYS_API_ID=
SUBFINDER_CENSYS_API_SECRET=

# https://github.com/settings/tokens
SUBFINDER_GITHUB_TOKEN=

# https://intelx.io/account?tab=developer
SUBFINDER_INTELX_API_KEY=

# https://urlscan.io/user/profile
SUBFINDER_URLSCAN_API_KEY=

# https://cloud.projectdiscovery.io/
NUCLEI_PDCP_API_KEY=

# ============================================
# OSINT / enrichment APIs
# Used by reference workflows and skills when those external APIs are queried.
# ============================================

# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# https://securitytrails.com/app/account/credentials
SECURITYTRAILS_API_KEY=

# https://hunter.io/api_keys
HUNTER_API_KEY=

# https://fullhunt.io/
FULLHUNT_API_KEY=

