{
  "description": "Restore repository-bound Vigil remediation context",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/remediation-context.mjs"],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
