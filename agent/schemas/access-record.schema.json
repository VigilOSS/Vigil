{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-research.local/schemas/access-record.schema.json",
  "$comment": "Generated by orchestrator/backend/scripts/generate_agent_schemas.py from app.api.assessment.AccessRecordRequest plus agent-side overlays where the CLI contract is intentionally stricter than the backend model.",
  "properties": {
    "access_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Access Key",
      "type": "string"
    },
    "credential_id": {
      "type": "integer",
      "default": null,
      "title": "Credential Id",
      "minimum": 1
    },
    "service_id": {
      "type": "integer",
      "default": null,
      "title": "Service Id",
      "minimum": 1
    },
    "principal": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Principal",
      "type": "string"
    },
    "access_level": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Access Level",
      "type": "string"
    },
    "target_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Target Ref",
      "type": "string"
    },
    "status": {
      "default": "active",
      "maxLength": 64,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "evidence_ref": {
      "default": "",
      "maxLength": 1024,
      "title": "Evidence Ref",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 4096,
      "title": "Notes",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    }
  },
  "required": [
    "access_key",
    "principal",
    "access_level",
    "target_ref"
  ],
  "title": "Assessment Access Record",
  "type": "object",
  "additionalProperties": false
}
