    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "status": {
      "default": "active",
      "maxLength": 32,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "severity": {
      "default": "info",
      "maxLength": 32,
      "minLength": 1,
      "title": "Severity",
      "type": "string"
    },
    "narrative": {
      "default": "",
      "maxLength": 20000,
      "title": "Narrative",
      "type": "string"
    },
    "evidence_ref": {
      "default": "",
      "maxLength": 1024,
      "title": "Evidence Ref",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "links": {
      "items": {
        "properties": {
          "relation": {
            "default": "step",
            "maxLength": 64,
            "minLength": 1,
            "title": "Relation",
            "type": "string"
          },
          "entity_kind": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Entity Kind",
            "type": "string"
          },
          "entity_id": {
            "type": "integer",
            "default": null,
            "title": "Entity Id",
            "minimum": 1
          },
          "entity_ref": {
            "default": "",
            "maxLength": 1024,
            "title": "Entity Ref",
            "type": "string"
          },
          "notes": {
            "default": "",
            "maxLength": 4096,
            "title": "Notes",
            "type": "string"
          },
          "provenance": {
            "additionalProperties": true,
            "title": "Provenance",
            "type": "object"
          }
        },
        "required": [
          "entity_kind"
        ],
        "title": "AttackChainLinkRequest",
        "type": "object",
        "additionalProperties": false
      },
      "title": "Links",
      "type": "array"
    }
  },
  "required": [
    "title"
  ],
  "title": "Assessment Attack Chain",
  "type": "object",
  "additionalProperties": false
