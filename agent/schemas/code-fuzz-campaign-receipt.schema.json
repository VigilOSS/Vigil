{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.local/schemas/code-fuzz-campaign-receipt.schema.json",
  "$comment": "Generated by orchestrator/backend/scripts/generate_agent_schemas.py from app.api.code_analysis.FuzzCampaignReceiptRequest plus agent-side overlays where the CLI contract is intentionally stricter than the backend model.",
  "additionalProperties": false,
  "properties": {
    "dispatch_id": {
      "exclusiveMinimum": 0,
      "title": "Dispatch Id",
      "type": "integer"
    },
    "repo_id": {
      "exclusiveMinimum": 0,
      "title": "Repo Id",
      "type": "integer"
    },
    "repo_generation": {
      "minimum": 1,
      "title": "Repo Generation",
      "type": "integer"
    },
    "source_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Digest",
      "type": "string"
    },
    "target_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "covered_finding_slugs": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Covered Finding Slugs",
      "type": "array",
      "uniqueItems": true
    },
    "engine": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Engine",
      "type": "string"
    },
    "sanitizers": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Sanitizers",
      "type": "array",
      "uniqueItems": true
    },
    "run_budget_seconds": {
      "maximum": 31536000,
      "minimum": 1,
      "title": "Run Budget Seconds",
      "type": "integer"
    },
    "executions": {
      "minimum": 0,
      "title": "Executions",
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "completed_no_crash",
        "completed_crashes_triaged",
        "build_failed",
        "campaign_failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "crash_count": {
      "minimum": 0,
      "title": "Crash Count",
      "type": "integer"
    },
    "triage_summary": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Triage Summary",
      "type": "string"
    },
    "evidence_ref": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Evidence Ref",
      "type": "string"
    },
    "rationale": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "dispatch_id",
    "repo_id",
    "repo_generation",
    "source_manifest_digest",
    "target_id",
    "covered_finding_slugs",
    "engine",
    "sanitizers",
    "run_budget_seconds",
    "executions",
    "outcome",
    "crash_count",
    "triage_summary",
    "evidence_ref",
    "rationale"
  ],
  "title": "Code Fuzz Campaign Receipt",
  "type": "object",
  "description": "Agent-attested bounded generation- and dispatch-bound sanitizer campaign outcome. Failure outcomes remain durable but do not close required obligations. Independent run ownership, build/harness/seed attestation, and per-crash lifecycle remain Wave 2D work.",
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed_no_crash"
          }
        }
      },
      "then": {
        "properties": {
          "crash_count": {
            "const": 0
          },
          "executions": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed_crashes_triaged"
          }
        }
      },
      "then": {
        "properties": {
          "crash_count": {
            "minimum": 1
          },
          "executions": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
