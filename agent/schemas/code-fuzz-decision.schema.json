{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.local/schemas/code-fuzz-decision.schema.json",
  "$comment": "Generated by orchestrator/backend/scripts/generate_agent_schemas.py from app.api.code_analysis.FuzzDecisionRequest plus agent-side overlays where the CLI contract is intentionally stricter than the backend model.",
  "additionalProperties": false,
  "properties": {
    "repo_id": {
      "exclusiveMinimum": 0,
      "title": "Repo Id",
      "type": "integer"
    },
    "repo_generation": {
      "minimum": 1,
      "title": "Repo Generation",
      "type": "integer"
    },
    "source_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Digest",
      "type": "string"
    },
    "decision": {
      "enum": [
        "required",
        "not_required"
      ],
      "title": "Decision",
      "type": "string"
    },
    "target_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Target Ids",
      "type": "array",
      "uniqueItems": true
    },
    "evidence_ref": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Evidence Ref",
      "type": "string"
    },
    "rationale": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "repo_id",
    "repo_generation",
    "source_manifest_digest",
    "decision",
    "target_ids",
    "evidence_ref",
    "rationale"
  ],
  "title": "Code Fuzz Applicability Decision",
  "type": "object",
  "description": "Agent-attested, evidence-hashed generation-bound decision to run or skip Phase 4 fuzzing. The backend rejects not_required while a current non-killed/non-merged native memory-safety finding exists. This acute gate is not an independent broker execution attestation.",
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "required"
          }
        }
      },
      "then": {
        "properties": {
          "target_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "not_required"
          }
        }
      },
      "then": {
        "properties": {
          "target_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
