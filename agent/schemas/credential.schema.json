{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.local/schemas/credential.schema.json",
  "$comment": "Generated by orchestrator/backend/scripts/generate_agent_schemas.py from app.api.assessment.CredentialRecordRequest plus agent-side overlays where the CLI contract is intentionally stricter than the backend model.",
  "properties": {
    "credential_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Credential Key",
      "type": "string"
    },
    "kind": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "principal": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Principal",
      "type": "string"
    },
    "secret": {
      "default": "",
      "description": "The credential secret value (password, token, key)",
      "maxLength": 1024,
      "title": "Secret",
      "type": "string"
    },
    "source_name": {
      "default": "",
      "maxLength": 128,
      "title": "Source Name",
      "type": "string"
    },
    "status": {
      "default": "discovered",
      "maxLength": 64,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 4096,
      "title": "Notes",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    }
  },
  "required": [
    "credential_key",
    "kind",
    "principal"
  ],
  "title": "Assessment Credential Record",
  "type": "object",
  "additionalProperties": false
}
