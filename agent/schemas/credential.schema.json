{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-research.local/schemas/credential.schema.json",
  "title": "Assessment Credential Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential_key", "kind", "principal"],
  "properties": {
    "credential_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "secret": {
      "type": "string",
      "maxLength": 1024
    },
    "source_name": {
      "type": "string",
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
