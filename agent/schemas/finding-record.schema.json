{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-research.local/schemas/finding-record.schema.json",
  "$comment": "Generated by orchestrator/backend/scripts/generate_agent_schemas.py from app.api.assessment.FindingRecordRequest plus agent-side overlays where the CLI contract is intentionally stricter than the backend model.",
  "additionalProperties": false,
  "properties": {
    "slug": {
      "maxLength": 256,
      "type": "string",
      "default": null,
      "title": "Slug",
      "minLength": 1
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "severity": {
      "default": "info",
      "maxLength": 32,
      "minLength": 1,
      "title": "Severity",
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "workflow_status": {
      "default": "active",
      "maxLength": 32,
      "minLength": 1,
      "title": "Workflow Status",
      "type": "string",
      "enum": [
        "draft",
        "active",
        "exploited",
        "blocked",
        "false_positive",
        "merged",
        "reported"
      ]
    },
    "verification_state": {
      "default": "unreviewed",
      "maxLength": 32,
      "minLength": 1,
      "title": "Verification State",
      "type": "string",
      "enum": [
        "unreviewed",
        "verified",
        "disputed"
      ]
    },
    "verification_disposition": {
      "default": "none",
      "maxLength": 32,
      "minLength": 1,
      "title": "Verification Disposition",
      "type": "string",
      "enum": [
        "none",
        "confirmed",
        "downgraded",
        "false_positive"
      ]
    },
    "defect_family": {
      "default": "",
      "maxLength": 128,
      "title": "Defect Family",
      "type": "string"
    },
    "root_cause_key": {
      "default": "",
      "maxLength": 256,
      "title": "Root Cause Key",
      "type": "string"
    },
    "auth_context": {
      "default": "anonymous",
      "maxLength": 128,
      "minLength": 1,
      "title": "Auth Context",
      "type": "string"
    },
    "canonical_location": {
      "default": "",
      "maxLength": 1024,
      "title": "Canonical Location",
      "type": "string"
    },
    "summary": {
      "default": "",
      "maxLength": 4096,
      "title": "Summary",
      "type": "string"
    },
    "evidence_ref": {
      "default": "",
      "maxLength": 1024,
      "title": "Evidence Ref",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 20000,
      "title": "Notes",
      "type": "string"
    },
    "source_name": {
      "default": "",
      "maxLength": 128,
      "title": "Source Name",
      "type": "string"
    },
    "details": {
      "additionalProperties": false,
      "title": "Details",
      "type": "object",
      "required": [
        "evidence",
        "impact"
      ],
      "properties": {
        "discovered_by": {
          "type": "string",
          "description": "Agent name that first identified this finding"
        },
        "owasp_category": {
          "type": "string",
          "description": "OWASP Top 10 category (for example, A03:2021 Injection)"
        },
        "cwe_id": {
          "type": "string",
          "description": "CWE identifier (for example, CWE-89 for SQL injection)"
        },
        "parameter": {
          "type": "string",
          "description": "Affected parameter name or input vector"
        },
        "slot_type": {
          "type": "string",
          "description": "Code-analysis slot type or attack input class associated with the finding"
        },
        "request_method": {
          "type": "string",
          "description": "HTTP method or triggering action (for example, GET, POST, PUT, DELETE)"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Exact response excerpt, artifact reference, or replayable proof"
        },
        "kill_reason": {
          "type": "string",
          "description": "Structured verifier rationale when a finding is marked false_positive"
        },
        "kill_check": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Verification check number responsible for the false-positive verdict"
        },
        "entry_point": {
          "type": "string",
          "description": "Source of attacker-controlled data (for example, function name, HTTP parameter, file read site)"
        },
        "sink": {
          "type": "string",
          "description": "Dangerous operation receiving tainted data (for example, memcpy call, SQL query, exec invocation)"
        },
        "taint_path": {
          "type": "string",
          "description": "Ordered attacker-controlled data flow from entry point to sink (narrative form)"
        },
        "guards_evaluated": {
          "type": "string",
          "description": "Guard analysis showing which checks exist and why they fail or can be bypassed"
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete attacker outcome and affected scope"
        },
        "cvss_vector": {
          "type": "string",
          "description": "CVSS 3.1 vector string (for example, CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N)"
        },
        "cvss_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Numeric CVSS 3.1 base score"
        },
        "remediation": {
          "type": "string",
          "description": "Recommended fix or the control that failed"
        },
        "steps_to_reproduce": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered reproduction steps, one string per step"
        },
        "poc_code": {
          "type": "string",
          "description": "Proof-of-concept exploit code or script that demonstrates the vulnerability"
        },
        "poc_request": {
          "type": "object",
          "description": "Structured HTTP request that triggers the vulnerability",
          "properties": {
            "method": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {
              "type": "string"
            }
          }
        },
        "poc_response": {
          "type": "object",
          "description": "Observed HTTP response confirming the vulnerability",
          "properties": {
            "status": {
              "type": "integer"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body_excerpt": {
              "type": "string"
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "External references such as CVE IDs, advisory URLs, or related documentation links"
        },
        "chain_required": {
          "type": "boolean",
          "description": "Whether this finding remains actionable only as part of a larger exploit chain"
        },
        "chain_rationale": {
          "type": "string",
          "description": "Why the finding matters primarily as a chain step instead of a standalone report item"
        },
        "required_followup": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Concrete follow-up steps needed to validate or complete the chain"
        },
        "variant_of": {
          "type": "string",
          "description": "Finding slug of the original finding when this record is a verified variant"
        },
        "original_pattern": {
          "type": "string",
          "description": "Abstract pattern signature copied from the original finding during variant analysis"
        }
      }
    },
    "provenance": {
      "additionalProperties": false,
      "title": "Provenance",
      "type": "object",
      "properties": {
        "agent_name": {
          "type": "string",
          "description": "Name of the agent that produced this finding"
        },
        "artifact": {
          "type": "string",
          "description": "Optional artifact reference associated with the finding provenance"
        }
      }
    },
    "request_variant_id": {
      "type": "integer",
      "default": null,
      "title": "Request Variant Id",
      "minimum": 1
    },
    "service_id": {
      "type": "integer",
      "default": null,
      "title": "Service Id",
      "minimum": 1
    },
    "surface_id": {
      "type": "integer",
      "default": null,
      "title": "Surface Id",
      "minimum": 1
    },
    "links": {
      "items": {
        "properties": {
          "link_kind": {
            "default": "related",
            "maxLength": 64,
            "minLength": 1,
            "title": "Link Kind",
            "type": "string"
          },
          "target_kind": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Target Kind",
            "type": "string"
          },
          "target_id": {
            "type": "integer",
            "default": null,
            "title": "Target Id",
            "minimum": 1
          },
          "target_ref": {
            "default": "",
            "maxLength": 1024,
            "title": "Target Ref",
            "type": "string"
          },
          "notes": {
            "default": "",
            "maxLength": 4096,
            "title": "Notes",
            "type": "string"
          },
          "provenance": {
            "additionalProperties": false,
            "title": "Provenance",
            "type": "object",
            "properties": {
              "agent_name": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "target_kind"
        ],
        "title": "FindingLinkRequest",
        "type": "object",
        "additionalProperties": false
      },
      "title": "Links",
      "type": "array"
    }
  },
  "required": [
    "title",
    "severity",
    "workflow_status",
    "verification_state",
    "verification_disposition",
    "defect_family",
    "root_cause_key",
    "auth_context",
    "canonical_location",
    "summary",
    "evidence_ref",
    "notes",
    "details"
  ],
  "title": "Assessment Finding Record",
  "type": "object",
  "examples": [
    {
      "title": "Blind SQL injection in search",
      "severity": "high",
      "defect_family": "sql-injection",
      "canonical_location": "https://target.example/search?q",
      "summary": "Boolean-blind SQL injection on the search endpoint",
      "evidence_ref": "scans/sqlmap.txt",
      "notes": "curl 'https://target.example/search?q=test%27+AND+1%3D1--+-' -> 200 with results",
      "details": {
        "owasp_category": "A03:2021 Injection",
        "cwe_id": "CWE-89",
        "request_method": "GET",
        "parameter": "q",
        "evidence": "Replayable request/response pair in scans/sqlmap.txt",
        "impact": "Anonymous attackers can extract arbitrary data from the backing store",
        "cvss_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N",
        "cvss_score": 7.5,
        "remediation": "Use parameterized queries for all search input",
        "steps_to_reproduce": [
          "Send GET /search?q=test'+AND+1=1--+-",
          "Observe normal search results returned"
        ],
        "poc_request": {
          "method": "GET",
          "url": "https://target.example/search?q=test'+AND+1=1--+-",
          "headers": {
            "Accept": "text/html"
          },
          "body": ""
        },
        "poc_response": {
          "status": 200,
          "headers": {
            "Content-Type": "text/html"
          },
          "body_excerpt": "<div class='results'>3 items found</div>"
        },
        "chain_required": false,
        "references": [
          "https://cwe.mitre.org/data/definitions/89.html"
        ],
        "discovered_by": "vulnerability-analyst"
      },
      "workflow_status": "active",
      "verification_state": "unreviewed",
      "verification_disposition": "none",
      "root_cause_key": "",
      "auth_context": "anonymous",
      "source_name": "vulnerability-analyst",
      "provenance": {
        "agent_name": "vulnerability-analyst"
      },
      "links": []
    },
    {
      "title": "Heap buffer overflow in URL parser via overlong scheme",
      "severity": "high",
      "defect_family": "buffer-overflow",
      "canonical_location": "file:lib/urlapi.c:342",
      "summary": "Attacker-controlled URL scheme exceeding 64 bytes overflows heap buffer in parseurl()",
      "details": {
        "cwe_id": "CWE-122",
        "impact": "Remote code execution via heap corruption",
        "evidence": "memcpy(buf, scheme, schemelen) copies attacker-controlled bytes without a bounds check",
        "entry_point": "curl_url_set(CURLURLPART_URL, attacker_url)",
        "sink": "memcpy(buf, scheme, schemelen) at lib/urlapi.c:342",
        "taint_path": "curl_url_set(CURLURLPART_URL, attacker_url) -> parseurl() -> memcpy(buf, scheme, schemelen)",
        "guards_evaluated": "No bounds check on schemelen before memcpy",
        "slot_type": "URL-COMPONENT",
        "chain_required": true,
        "chain_rationale": "The primitive is meaningful for exploitation, but final report impact depends on chaining it to a reachable crash or controlled allocation path.",
        "required_followup": [
          "Exercise the URL parser through a network-reachable caller",
          "Confirm whether the overflow produces controlled corruption under sanitizer instrumentation"
        ],
        "references": [
          "https://cwe.mitre.org/data/definitions/122.html"
        ],
        "discovered_by": "vulnerability-analyst"
      },
      "workflow_status": "active",
      "verification_state": "unreviewed",
      "verification_disposition": "none",
      "root_cause_key": "",
      "auth_context": "anonymous",
      "evidence_ref": "",
      "notes": "",
      "source_name": "vulnerability-analyst",
      "provenance": {
        "agent_name": "vulnerability-analyst"
      },
      "links": []
    }
  ]
}
