{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-research.local/schemas/finding-record.schema.json",
  "title": "Assessment Finding Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "severity",
    "status",
    "defect_family",
    "root_cause_key",
    "auth_context",
    "canonical_location",
    "summary",
    "evidence_ref",
    "notes",
    "details"
  ],
  "examples": [
    {
      "title": "Blind SQL injection in search",
      "severity": "high",
      "status": "confirmed",
      "defect_family": "sql-injection",
      "root_cause_key": "search-id-sqli",
      "auth_context": "anonymous",
      "canonical_location": "https://target.example/search?q",
      "summary": "Boolean-blind SQL injection on the search endpoint",
      "evidence_ref": "scans/sqlmap.txt",
      "notes": "curl 'https://target.example/search?q=test%27+AND+1%3D1--+-' → 200 with results; curl 'https://target.example/search?q=test%27+AND+1%3D2--+-' → 200 empty. Confirmed with sqlmap --batch --level=3.",
      "details": {
        "owasp_category": "A03:2021 Injection",
        "cwe_id": "CWE-89",
        "request_method": "GET",
        "parameter": "q",
        "evidence": "Replayable request/response pair in scans/sqlmap.txt",
        "impact": "Anonymous attackers can extract arbitrary data from the backing store",
        "cvss_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N",
        "cvss_score": 7.5,
        "remediation": "Use parameterized queries for all search input",
        "steps_to_reproduce": [
          "Send GET /search?q=test'+AND+1=1--+-",
          "Observe normal search results returned",
          "Send GET /search?q=test'+AND+1=2--+-",
          "Observe empty results — confirms boolean-blind SQLi"
        ]
      }
    }
  ],
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "confirmed", "exploited", "blocked", "false_positive", "merged", "reported"]
    },
    "defect_family": {
      "type": "string",
      "maxLength": 128
    },
    "root_cause_key": {
      "type": "string",
      "maxLength": 256
    },
    "auth_context": {
      "type": "string",
      "maxLength": 128
    },
    "canonical_location": {
      "type": "string",
      "maxLength": 1024
    },
    "summary": {
      "type": "string",
      "maxLength": 4096
    },
    "evidence_ref": {
      "type": "string",
      "maxLength": 1024
    },
    "notes": {
      "type": "string",
      "maxLength": 20000
    },
    "source_name": {
      "type": "string",
      "maxLength": 128
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "impact"],
      "properties": {
        "discovered_by": {
          "type": "string",
          "description": "Agent name that first identified this finding"
        },
        "owasp_category": {
          "type": "string",
          "description": "OWASP Top 10 category (e.g., A03:2021 Injection)"
        },
        "cwe_id": {
          "type": "string",
          "description": "CWE identifier (e.g., CWE-89 for SQL injection)"
        },
        "parameter": {
          "type": "string",
          "description": "Affected parameter name or input vector"
        },
        "request_method": {
          "type": "string",
          "description": "HTTP method or triggering action (e.g., GET, POST, PUT, DELETE)"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Exact response excerpt, artifact reference, or replayable proof"
        },
        "kill_reason": {
          "type": "string",
          "description": "Structured verifier rationale when a finding is marked false_positive"
        },
        "kill_check": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Verification check number responsible for the false-positive verdict"
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete attacker outcome and affected scope"
        },
        "cvss_vector": {
          "type": "string",
          "description": "CVSS 3.1 vector string (e.g., CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N)"
        },
        "cvss_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Numeric CVSS 3.1 base score"
        },
        "remediation": {
          "type": "string",
          "description": "Recommended fix or the control that failed"
        },
        "steps_to_reproduce": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered reproduction steps, one string per step"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_name": {
          "type": "string",
          "description": "Name of the agent that produced this finding"
        },
        "artifact": {
          "type": "string",
          "description": "Artifact path where this finding is synchronized (e.g., findings.md)"
        }
      }
    },
    "request_variant_id": {
      "type": "integer",
      "minimum": 1
    },
    "service_id": {
      "type": "integer",
      "minimum": 1
    },
    "surface_id": {
      "type": "integer",
      "minimum": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_kind"],
        "properties": {
          "link_kind": {
            "type": "string",
            "default": "related"
          },
          "target_kind": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "integer",
            "minimum": 1
          },
          "target_ref": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agent_name": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
