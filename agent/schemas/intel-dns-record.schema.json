{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.local/schemas/intel-dns-record.schema.json",
  "$comment": "Mirrors app.api.intel_schemas.DnsRecordRequest.",
  "title": "Intel DNS Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "name"
  ],
  "properties": {
    "record_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "description": "DNS record type (A, AAAA, CNAME, MX, TXT, NS, CERT, CAA, etc.)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Record name / owner."
    },
    "value": {
      "type": "string",
      "maxLength": 4096,
      "default": ""
    },
    "first_seen": {
      "type": "string",
      "maxLength": 64,
      "default": "",
      "description": "ISO8601 or free-form date string for first observation."
    },
    "last_seen": {
      "type": "string",
      "maxLength": 64,
      "default": ""
    },
    "source_name": {
      "type": "string",
      "maxLength": 128,
      "default": ""
    },
    "notes": {
      "type": "string",
      "maxLength": 4096,
      "default": ""
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "agent_name": {
          "type": "string"
        },
        "artifact_ref": {
          "type": "string"
        },
        "captured_at": {
          "type": "string"
        },
        "evidence_quote": {
          "type": "string"
        }
      }
    }
  }
}
