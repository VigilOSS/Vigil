    "service_id": {
      "type": "integer",
      "default": null,
      "title": "Service Id",
      "minimum": 1
    },
    "coverage_item_id": {
      "type": "integer",
      "default": null,
      "title": "Coverage Item Id",
      "minimum": 1
    },
    "auth_context": {
      "default": "anonymous",
      "maxLength": 128,
      "minLength": 1,
      "title": "Auth Context",
      "type": "string"
    },
    "input_slot": {
      "default": "unknown",
      "maxLength": 64,
      "minLength": 1,
      "title": "Input Slot",
      "type": "string"
    },
    "attack_family": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Attack Family",
      "type": "string"
    },
    "payload_family": {
      "default": "",
      "maxLength": 128,
      "title": "Payload Family",
      "type": "string"
    },
    "payload_value": {
      "default": "",
      "maxLength": 16384,
      "title": "Payload Value",
      "type": "string"
    },
    "tool_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tool Name",
      "type": "string"
    },
    "agent_name": {
      "default": "",
      "maxLength": 128,
      "title": "Agent Name",
      "type": "string"
    },
    "result_status": {
      "default": "tested",
      "maxLength": 64,
      "minLength": 1,
      "title": "Result Status",
      "type": "string"
    },
    "observed_http_status": {
      "type": "integer",
      "default": null,
      "title": "Observed Http Status"
    },
    "signal_type": {
      "default": "",
      "maxLength": 128,
      "title": "Signal Type",
      "type": "string"
    },
    "evidence_ref": {
      "default": "",
      "maxLength": 1024,
      "title": "Evidence Ref",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 4096,
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "attack_family",
    "tool_name"
