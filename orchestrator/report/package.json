{
  "name": "vigil-report",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "test_artifact=\"${TMPDIR:-/tmp}/vigil-report-poc.test.$$.cjs\" && trap 'rm -f \"$test_artifact\"' EXIT && esbuild src/lib/poc.test.ts --bundle --platform=node --format=cjs --outfile=\"$test_artifact\" && node --test \"$test_artifact\""
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
